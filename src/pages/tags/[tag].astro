---
import Base from "../../layouts/Base.astro";
import PostItem from "../../components/PostItem.astro";
import { getTags, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  return [...(await getTags())].map(([tag, posts]) => ({ params: { tag }, props: { posts } }));
}

const { tag } = Astro.params;
const { posts } = Astro.props as { posts: Post[] };
---

<Base title={`#${tag}`} description={`Posts tagged #${tag}.`}>
  <a class="crumb" href="/tags"><span aria-hidden="true">‹</span> Tags</a>
  <h1 class="page-title">#{tag}</h1>
  {posts.map((post) => <PostItem post={post} />)}
</Base>
