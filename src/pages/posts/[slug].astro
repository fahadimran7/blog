---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Tags from "../../components/Tags.astro";
import { SITE } from "../../site.config";
import { fmt, getPosts, iso, minutes, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props as { post: Post; newer?: Post; older?: Post };
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const { title, description, date, updated, tags } = post.data;
---

<Base title={title} description={description} image={`/og/${post.id}.png`} article={{ published: date, updated, tags }}>
  <a class="crumb" href="/posts"><span aria-hidden="true">‹</span> Posts</a>
  <article data-pagefind-body>
    <h1 class="article-title">{title}</h1>
    <div class="meta post-meta">
      <span>
        <time datetime={iso(date)}>{fmt(date)}</time> · {minutes(post)}
        {updated && <> · updated <time datetime={iso(updated)}>{fmt(updated, { month: "short", day: "numeric" })}</time></>}
      </span>
      <a class="edit" href={`${SITE.repo}/blob/main/${post.filePath}`} data-pagefind-ignore>
        <svg viewBox="0 0 24 24"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>Edit on GitHub
      </a>
    </div>

    {toc.length >= 2 && (
      <nav class="toc" data-pagefind-ignore>
        <b>On this page</b>
        {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
      </nav>
    )}

    <div class="prose"><Content /></div>
    {tags.length > 0 && <footer class="post-tags"><Tags tags={tags} /></footer>}
  </article>

  {(older || newer) && (
    <nav class="pager">
      {older && (
        <a class="prev" href={`/posts/${older.id}`}>
          <svg viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"></path></svg>
          <span><small>Prev</small><span class="t">{older.data.title}</span></span>
        </a>
      )}
      {newer && (
        <a class="next" href={`/posts/${newer.id}`}>
          <span><small>Next</small><span class="t">{newer.data.title}</span></span>
          <svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"></path></svg>
        </a>
      )}
    </nav>
  )}

  <script>
    for (const h of document.querySelectorAll(".prose :is(h2, h3)[id]")) {
      const a = document.createElement("a");
      a.className = "anchor";
      a.href = `#${h.id}`;
      a.ariaHidden = "true";
      a.tabIndex = -1;
      a.textContent = "#";
      h.append(a);
    }
    for (const pre of document.querySelectorAll(".prose pre")) {
      const btn = document.createElement("button");
      btn.className = "copy";
      btn.type = "button";
      btn.textContent = "copy";
      btn.addEventListener("click", async () => {
        await navigator.clipboard.writeText(pre.querySelector("code")?.innerText ?? "");
        btn.textContent = "copied";
        setTimeout(() => (btn.textContent = "copy"), 1500);
      });
      pre.append(btn);
    }
  </script>
</Base>
